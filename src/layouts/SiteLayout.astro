---
import '../styles/global.css';
const { title = 'Pine Tree Rifle Club', description = 'A member maintained rifle club in Johnstown, New York. Ranges, league scores, events, classes and club news.', current = 'Home' } = Astro.props;
const navigation=['Home','Scores','News','Events','Photos','Ranges','Membership','Classes','History','Contact'];
---
<!doctype html><html lang="en"><head><meta charset="utf-8"/><meta name="viewport" content="width=device-width,initial-scale=1"/><title>{title}</title><meta name="description" content={description}/><link rel="canonical" href={new URL(Astro.url.pathname,import.meta.env.SITE_URL || Astro.url.origin).href}/><meta property="og:title" content={title}/><meta property="og:description" content={description}/><meta property="og:type" content="website"/><meta property="og:image" content={new URL('/pics/clubhouse5.jpg',Astro.url.origin).href}/><link rel="icon" href="/store/storelogopatch.jpg"/></head><body>
<a class="skip" href="#main-content">Skip to main content</a>
<div class="topbar"><div class="wrap"><span>419 Johnson Avenue Ext. · Johnstown, NY</span><a href="tel:+15187624033">Call (518) 762‑4033</a></div></div>
<header class="wrap masthead"><a href="/" aria-label="Pine Tree Rifle Club home"><img class="logo" src="/store/storelogopatch.jpg" alt="Pine Tree Rifle Club emblem" width="90" height="90"/></a><div><div class="eyebrow">Established 1937</div><a class="brand" href="/">Pine Tree Rifle Club</a></div><form action="/search/"><label class="sr-only" for="site-search">Search the site</label><input id="site-search" name="q" type="search" placeholder="What are you looking for?"/><button type="submit">Search</button></form></header>
<nav class="nav" aria-label="Main navigation"><div class="wrap"><button type="button" id="menu" aria-expanded="false" aria-controls="navigation">Menu <span>{current}</span></button><div id="navigation" class="navlinks">{navigation.map(label=><a href={label==='Home'?'/':`/${label.toLowerCase()}/`} aria-current={current===label?'page':undefined}>{label}</a>)}</div></div></nav>
<main id="main-content" tabindex="-1"><slot/></main>
<footer class="footer"><div class="wrap"><div class="columns"><div><h2>Pine Tree Rifle Club</h2><p>419 Johnson Avenue Ext.<br/>Johnstown, NY 12095</p><p>Mail: P.O. Box 45, Johnstown, NY 12095</p></div><div><p><a href="tel:+15187624033">(518) 762‑4033</a></p><p><a href="/contact/">Contact &amp; directions</a> · <a href="/site-directory.html">All recovered pages</a></p><button type="button" id="large-text" aria-pressed="false">Larger text</button></div></div><div class="affiliates" role="group" aria-label="Club affiliations"><img src="/assets/images/affiliates/nra.webp" alt="National Rifle Association" loading="lazy"/><img src="/assets/images/affiliates/nysrpa.png" alt="New York State Rifle and Pistol Association" loading="lazy"/><img src="/assets/images/affiliates/cmp-seal.png" alt="Civilian Marksmanship Program" loading="lazy"/></div><p>Member maintained since 1937. <a href="/original-home.html">Restored original homepage</a></p></div></footer>
<script>
const menu=document.querySelector<HTMLButtonElement>('#menu');menu?.addEventListener('click',()=>{const open=menu.getAttribute('aria-expanded')!=='true';menu.setAttribute('aria-expanded',String(open));document.querySelector('#navigation')?.classList.toggle('open',open)});
const large=document.querySelector<HTMLButtonElement>('#large-text');function setLarge(on:boolean){document.documentElement.classList.toggle('large-text',on);large?.setAttribute('aria-pressed',String(on))}try{setLarge(localStorage.getItem('large-text')==='true')}catch{}large?.addEventListener('click',()=>{const on=!document.documentElement.classList.contains('large-text');setLarge(on);try{localStorage.setItem('large-text',String(on))}catch{}});
</script></body></html>
