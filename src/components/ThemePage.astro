---
import SiteLayout from '../layouts/SiteLayout.astro';
import content from '../data/theme-content.json';
import calendar from '../data/calendar.json';
import scores from '../data/scores.json';
import recovered from '../content/recovered.json';
const { slug='home', cmsPage, cmsNews, cmsNewsList }=Astro.props;
const news=cmsNewsList || content.news;
const staticPage=content.pages[slug];
const page=cmsPage || staticPage;
const titles={home:'Home',scores:'Scores',news:'News',events:'Events',search:'Search'};
const title=page?.title || titles[slug] || 'Club news';
const newsItem=cmsNews || content.news.find(n=>`news/${n.slug}`===slug);
const events=calendar.filter(e=>!e.cancelled && e.date>=new Date().toISOString().slice(0,10)).slice(0,4);
const latest=scores.filter(s=>s.league==='RIMFIRE' && s.scores[19]!==null).sort((a,b)=>b.scores[19]-a.scores[19]);
---
<SiteLayout title={`${newsItem?.title || title} — Pine Tree Rifle Club`} current={newsItem?'News':title} description={page?.description || newsItem?.description}>
{slug==='home'?<>
<div class="wrap hero"><div><p class="eyebrow">Johnstown, New York</p><h1>Thirty acres of ranges and pines, kept by our members since 1942.</h1><p>A place to practice, compete, learn, and lend a hand. Welcome to Pine Tree Rifle Club.</p><div class="toolbar"><a class="button" href="/scores/">Find my score</a><a class="button secondary" href="/membership/">Become a member</a></div></div><figure class="framed"><img src="/pics/clubhouse5.jpg" alt="Pine Tree Rifle Club clubhouse among the trees" width="600" height="330"/><figcaption class="caption">Our clubhouse in Johnstown, New York.</figcaption></figure></div>
<div class="wrap section columns"><section class="scorebox"><h2>Latest recovered league scores</h2><div class="scroll"><table><caption class="sr-only">2025–2026 rimfire pistol, week 20</caption><thead><tr><th scope="col">Place</th><th scope="col">Shooter</th><th scope="col">Score</th></tr></thead><tbody>{latest.slice(0,5).map((s,i)=><tr><td>{i+1}</td><td>{s.name}</td><td>{s.scores[19]}</td></tr>)}</tbody></table></div><p class="p-5"><a href="/scores/">All scores &amp; name search →</a></p></section><aside aria-label="Club information"><p class="eyebrow">At the club</p><h2>Before you visit</h2><p>Rifle and handgun ranges: 9 a.m. to dusk, except Wednesday.</p><div class="notice"><strong>Wednesday work party · 9 a.m.</strong><p>All ranges closed Wednesdays.</p></div><p>These notices were recovered from the original site. Please call to confirm current conditions.</p></aside></div>
<section class="wrap section"><h2>Around the club</h2><div class="cards">{news.map(n=><article class="card"><p class="tag">{n.tag}</p><h3><a href={`/news/${n.slug}/`}>{n.title}</a></h3><p>{n.description}</p><p class="caption">Recovered June 25, 2026</p></article>)}</div></section>
<section class="wrap section columns"><div><h2>From the recovered calendar</h2>{events.map(e=><article class="event"><time datetime={e.date}>{e.date.slice(5)}</time><div><h3>{e.summary}</h3><p>{e.startminutes!==undefined?`${Math.floor(e.startminutes/60)}:${String(e.startminutes%60).padStart(2,'0')}`:'Time not specified'}</p></div></article>)}<p><a href="/events/">View full calendar →</a></p></div><aside aria-label="Club resources"><h2>Make yourself at home</h2><p><a href="/ranges/">Our ranges</a></p><p><a href="/classes/">Classes &amp; training</a></p><p><a href="/history/">The club’s history</a></p><p><a href="/photos/">Photo recovery</a></p></aside></section>
</>:<>
<header class="band"><div class="wrap"><p class="eyebrow">Pine Tree Rifle Club</p><h1>{newsItem?.title || title}</h1><p class="lede">{page?.description || newsItem?.description || (slug==='scores'?'Find your name in the recovered 2025–2026 pistol league results.':slug==='events'?'Club meetings, leagues, classes, and work parties.':'Recovered club announcements and resources.')}</p></div></header>
<div class="wrap content">
{page && <Fragment set:html={page.body}/>}
{slug==='news' && <><p class="notice">These announcements were recovered June 25, 2026. Their original publication dates are unknown.</p><div class="cards">{news.map(n=><article class="card"><p class="tag">{n.tag}</p><h2><a href={`/news/${n.slug}/`}>{n.title}</a></h2><p>{n.description}</p></article>)}</div><p class="mt-8"><a href="/newsletter/ptrcnewsletter.html">Recovered newsletter</a> · <a href="/site-directory.html">Complete original content directory</a></p></>}
{newsItem && <article class="prose"><p class="caption">{newsItem.tag} · Recovered June 25, 2026 · Original publication date unknown</p><Fragment set:html={newsItem.body}/><p><a href="/news/">← All club news</a></p></article>}
{slug==='scores' && <><div class="notice">Recovered results, not a live feed. Week numbers are preserved; match dates were not supplied in the source. Averages below are calculated from recorded numeric scores and exclude absences.</div><div class="toolbar"><label for="league">League</label><select id="league">{[...new Set(scores.map(s=>s.league))].map(l=><option>{l}</option>)}</select><label for="name-filter">Your name</label><input id="name-filter" type="search" placeholder="Start typing your name"/><label for="week">Week</label><select id="week">{Array.from({length:20},(_,i)=><option value={i} selected={i===19}>{i+1}</option>)}</select><button type="button" id="print-scores">Print scores</button></div><p id="score-count" role="status"></p><div class="scroll"><table id="results"><caption>2025–2026 pistol league</caption><thead><tr><th scope="col">Place</th><th scope="col">Shooter</th><th scope="col">Score</th><th scope="col">Season average</th></tr></thead><tbody></tbody></table></div><p><a href="/pistol/pistol6.html">Complete original scores, including X counts</a></p><script type="application/json" id="score-data" set:html={JSON.stringify(scores).replace(/</g,'\\u003c')}/></>}
{slug==='events' && <><div class="notice">Recovered June 2026–December 2027 schedule. Confirm events with the club. Entries with ambiguous times are marked “Time not specified”; cancellations are retained in the downloadable calendar.</div><div class="toolbar"><label for="event-month">Month</label><input id="event-month" type="month" value="2026-10" min="2026-06" max="2027-12"/><a class="button" href="/assets/calendars/club-calendar.ics" download>Download calendar (.ics)</a></div><div id="event-list">{calendar.filter(e=>!e.cancelled).map(e=><article class="event" data-month={e.date.slice(0,7)}><time datetime={e.date}>{e.date}</time><div><h2 class="text-2xl">{e.summary}</h2><p>{e.startminutes!==undefined?`${Math.floor(e.startminutes/60)}:${String(e.startminutes%60).padStart(2,'0')} Eastern`:'Time not specified'}</p></div></article>)}</div><p id="event-status" role="status"></p><p><a href="/calendar.html">Original calendar</a></p></>}
{slug==='search' && <><label for="content-search">Search recovered pages</label><input id="content-search" type="search" class="w-full" placeholder="Enter a title or topic"/><p id="search-status" role="status"></p><ul id="search-results">{recovered.filter(e=>e.data.path!=='404.html').map(e=><li class="py-3 border-b border-rule" data-search={`${e.data.title} ${e.data.description}`.toLowerCase()}><a href={`/${e.data.path}`}>{e.data.title}</a><p class="caption">{e.data.description.slice(0,160)}</p></li>)}</ul></>}
</div></>}
</SiteLayout>
<script>
const month=document.querySelector<HTMLInputElement>('#event-month');function filterEvents(){let count=0;document.querySelectorAll<HTMLElement>('[data-month]').forEach(e=>{e.hidden=e.dataset.month!==month?.value;if(!e.hidden)count++});const status=document.querySelector('#event-status');if(status)status.textContent=`${count} events in this month.`}month?.addEventListener('input',filterEvents);if(month)filterEvents();
const data=document.querySelector('#score-data');if(data){const scores=JSON.parse(data.textContent||'[]');const league=document.querySelector<HTMLSelectElement>('#league')!;const name=document.querySelector<HTMLInputElement>('#name-filter')!;const week=document.querySelector<HTMLSelectElement>('#week')!;function render(){const rows=scores.filter(s=>s.league===league.value && s.name.toLowerCase().includes(name.value.toLowerCase())).sort((a,b)=>(b.scores[+week.value]??-1)-(a.scores[+week.value]??-1));const body=document.querySelector('#results tbody')!;body.replaceChildren();rows.forEach((s,i)=>{const tr=document.createElement('tr');const valid=s.scores.filter(v=>v!==null);[i+1,s.name,s.scores[+week.value]??'—',valid.length?(valid.reduce((a,b)=>a+b,0)/valid.length).toFixed(1):'—'].forEach(v=>{const td=document.createElement('td');td.textContent=String(v);tr.append(td)});body.append(tr)});document.querySelector('#score-count')!.textContent=`${rows.length} shooters found.`}for(const el of [league,name,week])el.addEventListener('input',render);render();document.querySelector('#print-scores')?.addEventListener('click',()=>window.print())}
const search=document.querySelector<HTMLInputElement>('#content-search');if(search){search.value=new URLSearchParams(location.search).get('q')||'';function filter(){let count=0;document.querySelectorAll<HTMLElement>('[data-search]').forEach(e=>{e.hidden=!e.dataset.search?.includes(search!.value.toLowerCase());if(!e.hidden)count++});document.querySelector('#search-status')!.textContent=`${count} pages found.`}search.addEventListener('input',filter);filter()}
</script>
