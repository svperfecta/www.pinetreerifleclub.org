---
import Base from '../layouts/Base.astro';
import recovered from '../content/recovered.json';
import { getEmDashEntry, getEmDashCollection } from 'emdash';
export const prerender = false;
let page;
const requestedPath = decodeURIComponent(Astro.params.path || 'index.html');
{
  const path = requestedPath;
  // EmDash's View/Preview links use the collection URL pattern. Preserve the
  // historic public path and any signed preview query when following them.
  if (path.startsWith('pages/')) {
    const result = await getEmDashEntry('pages', path.slice(6));
    if (result.error) throw result.error;
    if (result.entry) {
      const target = new URL(result.entry.data.path, Astro.url.origin + '/');
      if (target.origin !== Astro.url.origin) throw new Error('Page path must belong to this site');
      return Astro.redirect(target.pathname + Astro.url.search, 302);
    }
  }
  const reference = recovered.find(entry => entry.data.path === path);
  if (reference) {
    const result = await getEmDashEntry('pages', reference.slug);
    if (result.error) throw result.error;
    page = result.entry?.data;
    if (page && page.path !== path) page = undefined;
  }
  if (!page) {
    const result = await getEmDashCollection('pages', { where: { path }, limit: 1 });
    if (result.error) throw result.error;
    page = result.entries?.[0]?.data;
  }
  if (!page) { Astro.response.status = 404; page = recovered.find(entry => entry.data.path === '404.html').data; }
}
---
<Base page={page} requestPath={requestedPath} />
