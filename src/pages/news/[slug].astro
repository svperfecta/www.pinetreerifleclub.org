---
import ThemePage from '../../components/ThemePage.astro';
import content from '../../data/theme-content.json';
import {getEmDashEntry} from 'emdash';
export const prerender=false;
const slug=Astro.params.slug;

const result=await getEmDashEntry('club_content',`news-${slug}`);
if(result.error)throw result.error;
if(!result.entry){Astro.response.status=404;return new Response('Article not found',{status:404});}
---
<ThemePage slug={`news/${slug}`} cmsNews={result.entry?.data}/>
